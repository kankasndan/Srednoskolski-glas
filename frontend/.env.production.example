# Production. Copy to .env.production on the Next.js host before `next build`.
# NEXT_PUBLIC_* is baked into the client bundle at build time — changing the
# server env later has no effect until you rebuild.
#
# Must be the public HTTPS origin of the Laravel API (no trailing slash).
# Must match backend APP_URL. Leaving this unset fails the production build
# (the app will not fall back to localhost).

NEXT_PUBLIC_API_URL=https://api.example.com
