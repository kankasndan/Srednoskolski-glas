# NEXT_PUBLIC_API_URL is baked at build time and used by Next to proxy /api
# to Laravel. The browser calls same-origin /api (no CORS, first-party cookies).
# Paste the real backend public URL, e.g. https://backend-production-4c38.up.railway.app
# Do not use a guessed project-name hostname.
#
# Redeploy this service after the value changes.

NEXT_PUBLIC_API_URL=https://backend-production-4c38.up.railway.app
