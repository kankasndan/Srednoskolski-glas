APP_NAME="Srednoskolski Glas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# SPA origin. Must match the URL in the browser bar exactly (scheme + host + port).
# Do not mix localhost and 127.0.0.1 — they are different cookie hosts and 419 CSRF.
FRONTEND_URL=http://localhost:3000

APP_LOCALE=mk
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=srednoskolski_glas
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Leave empty locally. In production set to the parent domain (e.g. .example.com)
# only when the SPA and API share a site. Never set this for localhost.
SESSION_DOMAIN=
# Defaults to true when APP_ENV=production. Must be false on plain HTTP.
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

# Every frontend host:port that talks to this API. Include the port.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# Used by AdminSeeder. Required in production; local falls back to "password".
ADMIN_SEED_PASSWORD=

MEDIA_DRIVER=imagekit
MEDIA_DIRECTORY=uploads
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Must be a billed Gemini API key. Unpaid quota may be used to train Google's
# models and can be reviewed by humans — not acceptable for student photos.
# @see https://ai.google.dev/gemini-api/terms
CONTENT_MODERATION_ENABLED=true
CONTENT_MODERATION_DRIVER=gemini
CONTENT_MODERATION_ON_FAILURE=reject
GEMINI_API_KEY=
GEMINI_MODERATION_MODEL=gemini-2.5-flash-lite
GEMINI_VIDEO_FRAMES=3
# npm ignore-scripts is on, so this must be run once after npm install:
#   npm run ffmpeg:install
FFMPEG_PATH=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/api/auth/facebook/callback"
