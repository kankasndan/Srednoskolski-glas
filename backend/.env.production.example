# Production environment. Copy to .env on the API host and fill in secrets.
# Do not copy .env.example — that file is for local development (APP_DEBUG=true).
#
# Then: php artisan key:generate
#       php artisan config:cache && php artisan route:cache && php artisan view:cache
#
# Replace the example hosts with the real public URLs. Scheme must be https.
# FRONTEND_URL must match the address in the browser bar exactly (no trailing slash).

APP_NAME="Srednoskolski Glas"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

FRONTEND_URL=https://www.example.com

APP_LOCALE=mk
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=srednoskolski_glas
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Parent domain when the SPA and API share a site (api.example.com + www.example.com).
# Leave empty if both are the same host. Never use this on localhost.
SESSION_DOMAIN=.example.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Host[:port] of every SPA origin that sends cookies. No scheme.
SANCTUM_STATEFUL_DOMAINS=example.com,www.example.com

# Leave empty. Do not run DatabaseSeeder / AdminSeeder against production.
ADMIN_SEED_PASSWORD=

MEDIA_DRIVER=imagekit
MEDIA_DIRECTORY=uploads
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

CONTENT_MODERATION_ENABLED=true
CONTENT_MODERATION_DRIVER=gemini
CONTENT_MODERATION_ON_FAILURE=reject
GEMINI_API_KEY=
GEMINI_MODERATION_MODEL=gemini-2.5-flash-lite
GEMINI_VIDEO_FRAMES=3
# Absolute path to system ffmpeg on this host.
FFMPEG_PATH=/usr/bin/ffmpeg

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/api/auth/facebook/callback"

GIPHY_API_KEY=
