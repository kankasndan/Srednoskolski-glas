# Railway (isolated monorepo: /backend + /frontend)
#
# Service name in the Railway canvas must be `backend` for the frontend
# reference variables to resolve. Attach a MySQL plugin to this service.
#
# APP_KEY: php artisan key:generate --show
# Then paste the output (including base64:) as APP_KEY.

APP_NAME="Srednoskolski Glas"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

FRONTEND_URL=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}

APP_LOCALE=mk
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# Use ONLY these two. Do not paste local DB_HOST / DB_DATABASE / DB_USERNAME /
# DB_PASSWORD — Railway's database is named `railway`, not srednoskolski_glas.
DB_CONNECTION=mysql
DB_URL=${{MySQL.MYSQL_URL}}

CACHE_STORE=database
QUEUE_CONNECTION=database

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
# Browser calls /api on the SPA host (Next rewrite), so cookies are first-party.
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=${{frontend.RAILWAY_PUBLIC_DOMAIN}}

ADMIN_SEED_PASSWORD=

MEDIA_DRIVER=imagekit
MEDIA_DIRECTORY=uploads
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

CONTENT_MODERATION_ENABLED=true
CONTENT_MODERATION_DRIVER=gemini
CONTENT_MODERATION_ON_FAILURE=reject
GEMINI_API_KEY=
GEMINI_MODERATION_MODEL=gemini-2.5-flash-lite
GEMINI_VIDEO_FRAMES=3
FFMPEG_PATH=/usr/bin/ffmpeg

# Callbacks must use the FRONTEND host (Next /api proxy), not APP_URL.
# Leave these unset on Railway — railway-start.sh fills them from FRONTEND_URL.
# Also add the same URIs in Google Cloud / Facebook Developer consoles:
#   https://<frontend>/api/auth/google/callback
#   https://<frontend>/api/auth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=   # do not paste localhost; start script sets this

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# FACEBOOK_REDIRECT_URI= # do not paste localhost; start script sets this

GIPHY_API_KEY=
